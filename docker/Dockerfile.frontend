# Stage 1: Build Astro Landing Page
FROM node:25-alpine AS landing-build
WORKDIR /app
COPY landing-page/package*.json ./
RUN npm install --legacy-peer-deps
COPY landing-page/ .
RUN npm run build

# Stage 2: Build React SPA
FROM node:25-alpine AS frontend-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Stage 3: Nginx Runtime
FROM nginx:alpine AS runtime

# Copy Astro Landing Page static files to root (serves native index.html)
COPY --from=landing-build /app/dist/client /usr/share/nginx/html
COPY --from=landing-build /app/dist/client /usr/share/nginx/html/portal

# Copy React SPA static assets and app.html
COPY --from=frontend-build /app/dist /usr/share/nginx/html/spa
COPY --from=frontend-build /app/dist/assets /usr/share/nginx/html/assets
COPY --from=frontend-build /app/dist/index.html /usr/share/nginx/html/app.html

# Copy all public static assets from React frontend so /icon.svg, /icon-light.svg, /icon.png, etc. resolve at root
COPY --from=frontend-build /app/public/ /usr/share/nginx/html/

COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
