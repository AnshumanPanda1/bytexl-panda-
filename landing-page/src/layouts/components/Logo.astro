---
import config from "@/config/config.json";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand inline-block">
  {
    src || logo ? (
      <img
        src={src ? src : logo}
        class="inline-block"
        width={typeof logo_width === "string" ? logo_width.replace("px", "") : logo_width}
        height={typeof logo_height === "string" ? logo_height.replace("px", "") : logo_height}
        alt={title}
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
