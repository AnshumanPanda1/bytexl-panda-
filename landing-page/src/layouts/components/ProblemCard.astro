---
interface Props {
  index: number;
  title: string;
  icon: string;
}

const { index, title, icon } = Astro.props;
---

<div
  class="group relative flex flex-col justify-between h-full p-6 sm:p-7 rounded-2xl bg-[#0F0D22]/90 border border-white/[0.08] hover:border-primary/35 hover:bg-[#14102D]/95 transition-all duration-300 shadow-lg shadow-black/25"
>
  <div>
    <div class="flex items-center justify-between mb-5">
      <div
        class="flex items-center justify-center size-12 rounded-xl bg-white/[0.04] border border-white/[0.08] group-hover:bg-primary/10 group-hover:border-primary/25 transition-colors"
      >
        <img
          src={icon}
          alt=""
          class="size-7 object-contain"
          loading="lazy"
        />
      </div>
      <span class="text-xs font-mono font-medium text-text-dark/60 tracking-wider select-none">
        0{index + 1}
      </span>
    </div>
    <h3 class="text-base sm:text-lg font-semibold text-white tracking-tight leading-snug group-hover:text-white transition-colors">
      {title}
    </h3>
  </div>
</div>
